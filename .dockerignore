mlflow.db

# App runtime data (created on the instance, not baked into the image)
media/
signalcare.db

# yt-dlp cookies file (mounted at runtime, not baked into the image)
cookies.txt

# Environment / secrets
.env
.venv
venv/

# VCS / editor / docs
.git/
.gitignore
.claude/
*.md

# Python
__pycache__/
*.pyc
.pytest_cache/

# Notebooks
*.ipynb
.ipynb_checkpoints/
